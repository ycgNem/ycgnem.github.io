{
  "name": "ycgnem-site",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:js": "esbuild src/main.ts --bundle --minify --target=es2020 --outfile=assets/js/site.js",
